{
  "expo": {
    "name": "Médico Amigo",
    "slug": "medico-amigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmedkhalil.medicoamigo"
    },
    "android": {
      "package": "com.ahmedkhalil.medicoamigo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Médico Amigo Utilize a câmara para ler as embalagens de medicamentos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Médico Amigo utiliza a sua localização para encontrar farmácias próximas."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c6364031-91e4-48fb-9817-e037de5ad78e"
      }
    },
    "owner": "yolokamatcho07"
  }
}
